# ===========================================================================
# .env.example  —  Next.js app configuration (frontend)
# Copy to `.env.local` and fill in. These values are exposed to the browser
# (NEXT_PUBLIC_*), so never put secret keys here.
# ===========================================================================

# Address of the deployed RWAAsset contract on X Layer TESTNET (chain 1952).
# After running `npm run deploy:testnet`, paste the printed address here.
NEXT_PUBLIC_RWA_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0xcb8bf24c6ce16ad21d707c9505421a17f2bec79d
NEXT_PUBLIC_FEE_COLLECTOR=0x5905c9Dea6Ae52AA0947D8F7F218263889eDfC4E
NEXT_PUBLIC_RWA_DEPLOYMENT_BLOCK=38100000
NEXT_PUBLIC_MARKETPLACE_DEPLOYMENT_BLOCK=38100000

# X Layer MAINNET (chain 196). Leave blank until fresh mainnet deployments
# are verified. The app remains testnet-first and exposes a network switcher.
NEXT_PUBLIC_MAINNET_RWA_ADDRESS=
NEXT_PUBLIC_MAINNET_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=
NEXT_PUBLIC_MAINNET_FEE_COLLECTOR=0x5905c9Dea6Ae52AA0947D8F7F218263889eDfC4E
NEXT_PUBLIC_MAINNET_RWA_DEPLOYMENT_BLOCK=0
NEXT_PUBLIC_MAINNET_MARKETPLACE_DEPLOYMENT_BLOCK=0

# Mainnet deployment inputs (server/deployer only; never expose PRIVATE_KEY).
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
MAINNET_USDC_ADDRESS=
MAINNET_FEE_COLLECTOR=0x5905c9Dea6Ae52AA0947D8F7F218263889eDfC4E

# AI provider. Without it, image/document evidence cannot receive mint approval.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Hackathon media persistence. Use a dedicated repository and fine-grained token.
# Without a token, the demo falls back to content-addressed data URIs.
GITHUB_MEDIA_TOKEN=
GITHUB_MEDIA_REPO=TS-mfon/xlayer-estate-media
GITHUB_MEDIA_BRANCH=main

# Server-only EIP-712 signing identity. Never use the deployer key here.
UNDERWRITER_PRIVATE_KEY=
UNDERWRITER_SESSION_SECRET=

# Optional durable Neon read model. Contracts remain authoritative; without
# DATABASE_URL the server APIs read X Layer directly and remain functional.
DATABASE_URL=
INDEXER_SECRET=

# V2 protocol deployment inputs. V2 is not configured in the browser until a
# deployment manifest has been reviewed and its addresses are added explicitly.
UNDERWRITER_ADDRESS=
AGENT_ADDRESS=
NEXT_PUBLIC_V2_EVIDENCE_ADDRESS=
NEXT_PUBLIC_V2_POLICY_ADDRESS=
NEXT_PUBLIC_V2_PASSPORT_ADDRESS=
NEXT_PUBLIC_V2_REGISTRY_ADDRESS=
NEXT_PUBLIC_V2_MARKET_ADDRESS=
NEXT_PUBLIC_V2_GATEWAY_ADDRESS=
NEXT_PUBLIC_V2_DEPLOYMENT_BLOCK=0
