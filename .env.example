# ===========================================================================
# .env.example  —  Next.js app configuration (frontend)
# Copy to `.env.local` and fill in. These values are exposed to the browser
# (NEXT_PUBLIC_*), so never put secret keys here.
# ===========================================================================

# Address of the deployed RWAAsset contract on X Layer TESTNET (chain 1952).
# After running `npm run deploy:testnet`, paste the printed address here.
NEXT_PUBLIC_RWA_ADDRESS=

# AI provider (optional — app falls back to a built-in mock underwriter without it)
GEMINI_API_KEY=

# Optional: Pinata JWT to store underwriting reports on IPFS.
# Without it, the app uses an explicit content-addressed data URI fallback.
PINATA_JWT=
